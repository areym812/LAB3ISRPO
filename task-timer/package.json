{
  "name": "task-timer",
  "displayName": "Task Timer",
  "description": "A simple work timer with settings and productivity statistics.",
  "version": "1.0.0",
  "publisher": "student-project",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:taskTimer.open"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "taskTimer.open",
        "title": "Task Timer: Open"
      }
    ],
    "keybindings": []
  },
  "scripts": {
    "check": "node --check extension.js && node --check media/app.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0"
  }
}
